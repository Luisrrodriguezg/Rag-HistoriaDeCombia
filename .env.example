# ============================================================
# Postgres (pgvector)
# ============================================================
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag:rag@db:5432/rag

# ============================================================
# Keycloak
# ============================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Host port for Keycloak. Override if 8080 is already taken on your machine
# (remember to update VITE_KEYCLOAK_URL and KEYCLOAK_EXTERNAL_ISSUER below).
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=rag
KEYCLOAK_CLIENT_ID=rag-frontend
# Internal (container-to-container) — used by backend for JWKS
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/rag
KEYCLOAK_INTERNAL_JWKS_URL=http://keycloak:8080/realms/rag/protocol/openid-connect/certs
# External (browser-facing) — issuer in the token will match this
KEYCLOAK_EXTERNAL_ISSUER=http://localhost:8080/realms/rag

# ============================================================
# Ollama (HOST — this branch uses Metal/GPU on Mac)
#
# The backend container reaches the host via `host.docker.internal`.
# Make sure Ollama on the host is bound to 0.0.0.0:11434 (NOT 127.0.0.1)
# so containers can connect — see README "Metal mode" section.
# ============================================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
# Context window passed to ChatOllama. Default 2048 is too small for 5 RAG
# chunks + the answer prompt; 8192 fits comfortably.
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model loaded after the last request.
OLLAMA_KEEP_ALIVE=30m

# ============================================================
# RAG tuning
# ============================================================
RAG_SIMILARITY_THRESHOLD=0.55
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Skip the LLM document-grading call when every retrieved chunk scores above
# this similarity — saves one LLM call on confident retrievals.
RAG_GRADING_SKIP_THRESHOLD=0.85
# Cuántos turnos previos (pregunta + respuesta) se incluyen en el prompt del LLM
# para que entienda follow-ups conversacionales (pronombres, "y...", "ese", etc.)
CHAT_HISTORY_TURNS=3

# One-shot. Set to 1 when changing the embedding model so init_db drops the
# chunks table + IVFFlat index before recreating them at the new dimension.
# Unset after the reindex completes.
# RAG_RESET_VECTORS=1

# ============================================================
# Backend
# ============================================================
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173
DOCS_STORAGE_PATH=/data/docs
LOG_LEVEL=INFO

# ============================================================
# Frontend (Vite — variables must be prefixed with VITE_)
# ============================================================
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=rag
VITE_KEYCLOAK_CLIENT_ID=rag-frontend
